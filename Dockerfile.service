# check=skip=FromPlatformFlagConstDisallowed
# The service profile's image (design 5.9, docs/DEPLOY.md). linux/amd64 only, and never Alpine: Chrome Headless Shell
# and a pack's native packages are glibc x86-64 builds, so every stage pins the platform. It holds no template pack,
# no browser and no key: a deployment adds its pack in a derived image (fixtures/pack/Dockerfile.derived) and passes
# its keys in the environment at run time.

# Build: compile dist-service/ with the dev dependencies, then drop them.
FROM --platform=linux/amd64 node:22-bookworm-slim AS build
WORKDIR /app
# Only what the service build reads, so nothing else in the build context can reach an image layer.
COPY package.json package-lock.json tsconfig.json tsconfig.service.json ./
RUN npm ci
COPY src/ src/
RUN npm run build:service
RUN npm prune --omit=dev

# Runtime.
FROM --platform=linux/amd64 node:22-bookworm-slim
WORKDIR /app
# tini runs as PID 1, so orphans are reaped and SIGTERM reaches the service. util-linux carries setpriv, which
# Remotion wraps Chrome in for its pdeathsig. fonts-noto-core is the fallback for text a pack's own fonts do not
# cover. The rest are Chrome Headless Shell's shared libraries.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    tini util-linux fonts-noto-core \
    libnss3 libnspr4 libasound2 libgbm1 libxkbcommon0 libdbus-1-3 libatk-bridge2.0-0 libcups2 libpango-1.0-0 \
    libcairo2 \
  && rm -rf /var/lib/apt/lists/*
# No npm: the service never installs anything, and never falls back to npx.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
# package.json carries "type": "module", which dist-service/'s ES modules need.
COPY --from=build /app/package.json ./
COPY --from=build /app/dist-service/ dist-service/
COPY --from=build /app/node_modules/ node_modules/
# The audit log's directory. The service refuses to start unless AUDIT_LOG_PATH can be opened for appending.
RUN mkdir -p /var/log/remotion-viz && chown node:node /var/log/remotion-viz && chmod 0750 /var/log/remotion-viz
USER node
ENTRYPOINT ["/usr/bin/tini","--","node","dist-service/service/index.js"]
# GET /mcp on 127.0.0.1:${SERVICE_PORT:-8080}, healthy only on the 405 a live service answers. Not audited.
HEALTHCHECK CMD ["node","dist-service/service/healthcheck.js"]
