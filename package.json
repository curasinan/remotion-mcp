{
  "name": "remotion-viz-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Remotion video rendering and SVG/HTML visualization rasterization",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "remotion-viz-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node smoke-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@resvg/resvg-js": "^2.6.2",
    "fast-xml-parser": "^4.5.0",
    "puppeteer-core": "^24.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
